# ── third-party reference clones (CodebuffAI/freebuff, 9router, etc.) ──
reference/

# ── stray vendor clone guard (an old arg-parser bug cloned upstream into ./main) ──
/main/

# ── local secrets / credentials ──
.env
.env.local
.env.*
!.env.example
!.env.full-example
config.json
config.*.json
!config.example.json
!frontend/e2e/fixtures/config.json
!frontend/e2e/fixtures-realworld/config.json
*.pem
*.key

# ── runtime artifacts ──
dump/
*.log
dist/
!backend/internal/dashboard/dist/
out/
bin/
tmp/
.playwright-mcp/
/.drift-report.json
.ruff_cache/

# ── build outputs (Go binaries) ──
/freebuff-proxy
*.exe
*.test
*.out
coverage.out
coverage.html
*.prof

# ── editors / IDEs ──
.idea/
.vscode/
*.swp
*.swo

# ── OS cruft ──
Thumbs.db
Desktop.ini
.DS_Store

# ── SDD scratch ──
.superpowers/

# ── dev tooling & verification (local only, not published) ──
.codegraph/
uicheck/
scripts/token_ref/
frontend/verify-ui.mjs
frontend/test-results/
frontend/playwright-report/
.worktrees/

# ── misc ──
node_modules/
*.tmp
*.bak

# ── agent handoff docs (local only, not repo content) ──
HANDOFF.md
*.handoff.md
plan.md
PLAN.md
*.plan.md

# ── dev docs & study (local only, not repo content) ──
devdocs/

# ── docs/ is public: only top-level .md files are committed ──
docs/*
!docs/*.md

# ── proxy session persistence (SHA-256 token keys + instance state) ──
.freebuff-session-state.json
.freebuff-session-state.json.*
*.session-state.json

# local agent tool state (skills.sh installs, session artifacts)
.agents/
.claude/
skills-lock.json

# Windows build backups (rename-aside of locked exe)
*.exe~
API_Keys*
