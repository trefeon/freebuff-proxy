# freebuff-proxy minimal env — 7 kunci esensial (lihat .env.example untuk lengkapnya).
AUTH_TOKENS= # token upstream, kosong = bridge mode
SAFE_MODE=true # preset anti-ban, biarkan ON
COST_MODE=free # wajib free, selain itu ditagih paid
LISTEN_ADDR=127.0.0.1:3457 # loopback default, :3457 untuk LAN/Docker
ADMIN_TOKEN=123456 # ganti sebelum expose port
LOG_LEVEL=info # debug | info | warn | error
MAX_MESSAGES_PER_DAY=0 # 0 = tanpa cap lokal
