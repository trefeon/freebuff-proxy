# freebuff-proxy configuration — complete reference
# All keys can be set via environment variables or inside this .env file.

# Upstream auth token(s). Comma-separated for multi-token pooling.
# Empty = bridge mode (clients supply tokens via Authorization: Bearer <token>).
AUTH_TOKENS=
#HYBRID_MODE=false  # true = pooled pool + per-client bridge relay in one process:
                     # a client Authorization: Bearer token is relayed like bridge,
                     # token-less requests fall back to the AUTH_TOKENS pool
#MODELS_HIDE_UNAVAILABLE=false  # true = /v1/models prunes region/tier/quota-locked models

# Bearer token required for POST /admin/reload (empty = unauthenticated; set to protect the admin endpoint)
# Bearer token required for POST /admin/reload and the /admin dashboard login
# (empty = unauthenticated; set one to protect the admin endpoint and UI)
ADMIN_TOKEN=

# Account safety mode (enables anti-ban stealth: JA3 TLS fingerprinting, header sanitization, request jitter)
# Default is true; set SAFE_MODE=false to disable.
SAFE_MODE=true

# Server bind address (loopback by default; containers set LISTEN_ADDR=:3457)
LISTEN_ADDR=127.0.0.1:3457

# Upstream API endpoint
UPSTREAM_BASE_URL=https://codebuff.com

# Rotation & timeouts
ROTATION_INTERVAL=6h
IDLE_ROTATION_TIMEOUT=30m

# Daily message quota per token (0 = unlimited — the default).
# Unlimited is safe: when upstream returns 429, the proxy captures the exact reset window
# and locks the token locally in memory, preventing repeated upstream requests / spam.
MAX_MESSAGES_PER_DAY=0

# Outbound proxy routing
SOCKS5_PROXY=
HTTP_PROXY=

# Browser TLS stealth fingerprint (auto, chrome126, firefox128, safari18, edge126)
TLS_FINGERPRINT=auto

# Persist session state across restarts (resume unexpired sessions instead of
# burning a new daily slot). Opt-in.
#SESSION_PERSIST=false
#SESSION_STATE_FILE=.freebuff-session-state.json

# Logging
LOG_LEVEL=info
# Optional log file (empty = stderr only). File paths in this file are
# relative to the process working directory, so ./logs/proxy.log is created
# next to where the proxy was started (the directory is made automatically).
#LOG_FILE=./logs/proxy.log
